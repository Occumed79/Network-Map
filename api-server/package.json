{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "packageManager": "pnpm@10.17.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "pnpm --filter @workspace/db exec tsc -p tsconfig.json && tsc -p tsconfig.json --noEmit",
    "test:provider-explorer": "node --import ../occu-med-map/node_modules/tsx/dist/loader.mjs scripts/provider-explorer-smoke.ts",
    "test:p1-data": "node --import ../occu-med-map/node_modules/tsx/dist/loader.mjs scripts/p1-data-stabilization-smoke.ts",
    "test:p3-npi": "node --import ../occu-med-map/node_modules/tsx/dist/loader.mjs scripts/p3-central-npi-smoke.ts",
    "test:provider-search-authority": "node --import ../occu-med-map/node_modules/tsx/dist/loader.mjs scripts/provider-search-authority-smoke.ts",
    "test:provider-integrity": "node --import ../occu-med-map/node_modules/tsx/dist/loader.mjs scripts/provider-integrity-smoke.ts",
    "test:provider-upload-lifecycle": "node --import ../occu-med-map/node_modules/tsx/dist/loader.mjs scripts/provider-upload-lifecycle-smoke.ts",
    "test:api-security": "node --import ../occu-med-map/node_modules/tsx/dist/loader.mjs scripts/api-security-smoke.ts",
    "test:database-lifecycle": "node --import ../occu-med-map/node_modules/tsx/dist/loader.mjs scripts/database-lifecycle-smoke.ts"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "pino": "^9",
    "pino-http": "^10"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0"
  }
}
