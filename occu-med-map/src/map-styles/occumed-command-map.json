{
  "version": 8,
  "name": "Occu-Med Command Map",
  "metadata": {
    "mapbox:autocomposite": false,
    "occumed:purpose": "Professional global provider intelligence basemap style for Mapbox or MapLibre rendering"
  },
  "center": [-30, 28],
  "zoom": 2,
  "bearing": 0,
  "pitch": 0,
  "sources": {
    "osm-raster": {
      "type": "raster",
      "tiles": [
        "https://a.tile.openstreetmap.org/{z}/{x}/{y}.png",
        "https://b.tile.openstreetmap.org/{z}/{x}/{y}.png",
        "https://c.tile.openstreetmap.org/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "attribution": "© OpenStreetMap contributors"
    },
    "live-providers": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    },
    "network-coverage": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    }
  },
  "sprite": "",
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#b8dce6"
      }
    },
    {
      "id": "osm-raster-base",
      "type": "raster",
      "source": "osm-raster",
      "paint": {
        "raster-opacity": 0.96,
        "raster-saturation": 0.08,
        "raster-contrast": 0.04,
        "raster-brightness-min": 0.03,
        "raster-brightness-max": 1
      }
    },
    {
      "id": "network-coverage-fill",
      "type": "fill",
      "source": "network-coverage",
      "paint": {
        "fill-color": "#0ea5e9",
        "fill-opacity": 0.12
      },
      "filter": ["==", ["geometry-type"], "Polygon"]
    },
    {
      "id": "network-coverage-outline",
      "type": "line",
      "source": "network-coverage",
      "paint": {
        "line-color": "#0369a1",
        "line-width": 1.2,
        "line-opacity": 0.38
      },
      "filter": ["==", ["geometry-type"], "Polygon"]
    },
    {
      "id": "provider-density",
      "type": "circle",
      "source": "live-providers",
      "paint": {
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 2, 2, 7, 4, 12, 7],
        "circle-color": [
          "match",
          ["get", "category"],
          "hospital", "#0f766e",
          "clinic", "#2563eb",
          "doctor", "#1d4ed8",
          "urgent", "#b45309",
          "lab", "#7c3aed",
          "dentist", "#0891b2",
          "pharmacy", "#16a34a",
          "eye", "#4f46e5",
          "#475569"
        ],
        "circle-opacity": 0.78,
        "circle-stroke-color": "#ffffff",
        "circle-stroke-width": 1,
        "circle-stroke-opacity": 0.86
      },
      "filter": ["==", ["geometry-type"], "Point"]
    },
    {
      "id": "provider-highlight",
      "type": "circle",
      "source": "live-providers",
      "paint": {
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 2, 5, 8, 9, 13, 14],
        "circle-color": "#0284c7",
        "circle-opacity": 0.12,
        "circle-stroke-color": "#0284c7",
        "circle-stroke-width": 1,
        "circle-stroke-opacity": 0.24
      },
      "filter": ["all", ["==", ["geometry-type"], "Point"], ["==", ["get", "selected"], true]]
    }
  ]
}
