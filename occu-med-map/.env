# Zocdoc credentials (optional for public pages, required for authenticated features)
ZOCDOC_USERNAME=your_login_here
ZOCDOC_PASSWORD=your_password_here

# Mapbox tokens (3D globe and flat 2D map)
VITE_MAPBOX_TOKEN=your_mapbox_token_here
VITE_MAPBOX_TOKEN_2=your_second_mapbox_token_here

# Radiology Assist credentials (required)
RADIOLOGY_ASSIST_USERNAME=your_username_here
RADIOLOGY_ASSIST_PASSWORD=your_password_here
